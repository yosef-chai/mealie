<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17: גישה לשרת ברשת הביתית. מתבקשת בזמן ריצה רק כשמוגדרת כתובת פרטית. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- עדכון עצמי מ-GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- טיימר בשעון של הטלפון (AlarmClock.ACTION_SET_TIMER) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- הורדות ל-Downloads ב-Android 9 ומטה (מ-10 ומעלה MediaStore לא דורש הרשאה). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <application
        android:name=".MealieApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Mealie"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mealie"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Mealie.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.github.yosefchai.mealie.action.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mealie-shortcut" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- שיתוף קישור מתכון מכל אפליקציה: מחלץ את ה-URL ומעביר לייבוא. -->
        <activity
            android:name=".share.ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_label"
            android:noHistory="true"
            android:theme="@style/Theme.Mealie.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          נפילה ל-Custom Tab כשהדפדפן לא תומך ב-Auth Tab. בלי host ה-path לא משפיע,
          ולכן הסינון לפי scheme בלבד.
        -->
        <activity
            android:name=".auth.OAuthRedirectActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.Mealie.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${oauthScheme}" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />

        <!-- שמירת שפת האפליקציה ב-Android 12 ומטה (ב-13 ומעלה המערכת שומרת). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- ווידג'טים למסך הבית -->
        <receiver
            android:name=".widget.ShoppingListWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_shopping_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_shopping_info" />
        </receiver>

        <receiver
            android:name=".widget.MealPlanWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_meals_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_meals_info" />
        </receiver>

        <activity
            android:name=".widget.ShoppingWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_choose_list"
            android:theme="@style/Theme.Mealie">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
